# Copy this file to .env.local and fill in real values.
# The committed file is .env.example — never commit .env.local (it is gitignored).

# ── LLM gateway ───────────────────────────────────────────────────────
# Provider is config-only. Production MUST use api (Anthropic Console
# API-key auth); cli (Claude Code CLI, Max-plan OAuth) is for local dev ONLY
# and violates Anthropic's Consumer Terms if used in a shipped product.
LLM_PROVIDER=api
# Required when LLM_PROVIDER=api — an Anthropic Console API key (sk-ant-...).
ANTHROPIC_API_KEY=
# Model alias: sonnet | opus | haiku (or a full model id).
LLM_MODEL=sonnet
# Anthropic SDK tuning.
LLM_MAX_RETRIES=2
LLM_TIMEOUT=120
# Per-tenant rate cap (LLM calls/min). 0 disables; set a real cap in prod.
LLM_RATE_LIMIT_PER_MIN=0
# Max concurrent gateway calls when fanning out (e.g. scoring N candidates).
LLM_MAX_CONCURRENCY=3
# Local-dev CLI provider only (LLM_PROVIDER=cli): full path to claude if not on PATH.
# CLAUDE_BIN=

# ── Supabase (local Docker) ───────────────────────────────────────────
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=your-local-service-key
SUPABASE_ANON_KEY=your-local-anon-key
# Direct Postgres connection (used by backend for SQL / pgvector)
DATABASE_URL=postgresql://postgres:localpassword@localhost:5432/ta_agent

# ── Redis (local Docker) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Apify (LinkedIn scraping — pay-per-run, ~$0.50/run) ───────────────
APIFY_API_TOKEN=your-apify-token
# Set to "true" to use built-in mock data instead of calling Apify (no cost)
USE_MOCK_SOURCING=true

# ── Talent Hunt (outbound) ───────────────────────────────────────────
# Apollo for outbound people search; blank = criteria-filtered mock pool.
APOLLO_API_KEY=

# ── Official Website channel — Ceipal career portal ──────────────────
# Public widget creds from your careers page's Ceipal widget <script> tag.
# When set, the Website channel pulls live jobs from Ceipal.
CEIPAL_API_KEY=
CEIPAL_CP_ID=
# Ceipal ATS API (Option B — pull applicants who applied). Admin creds from
# Ceipal → Settings → API. Separate from the public widget key above.
CEIPAL_ATS_EMAIL=
CEIPAL_ATS_PASSWORD=
CEIPAL_ATS_API_KEY=

# ── Google Forms via Google Sheets ───────────────────────────────────
# Service-account JSON path (share the responses Sheet with its client_email),
# and the default responses Sheet id. Blank = built-in mock form responses.
GOOGLE_SHEETS_SA_FILE=
GOOGLE_FORMS_SHEET_ID=

# ── LinkedIn Apply Connect webhook ───────────────────────────────────
LINKEDIN_WEBHOOK_SECRET=

# ── LinkedIn profile-scraper enrichment (OPT-IN — ToS/account-ban risk) ──
# Off by default. Requires: pip install linkedin-scraper playwright;
# playwright install chromium; python scripts/create_linkedin_session.py
LINKEDIN_SCRAPE_ENABLED=false
LINKEDIN_SESSION_FILE=

# ── Email (Resend free tier: 3,000 emails/month) ─────────────────────
RESEND_API_KEY=your-resend-key
OUTREACH_FROM_EMAIL=recruiting@yourdomain.com

# ── Gmail (OAuth — SEND decision emails + READ replies) ──────────────
# One OAuth credential does both. Scopes: gmail.send + gmail.readonly.
# Create an OAuth client (Google Cloud → Credentials), consent once, store the
# refresh token. OUTREACH_FROM_EMAIL must be that Gmail/Workspace address.
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# ── Google Calendar ──────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=your-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-client-secret

# ── Next.js (frontend) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
